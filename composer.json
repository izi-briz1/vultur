{
    "require": {
        "smarty/smarty": "^5.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "fakerphp/faker": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "build-css": "sassc -t compressed ./public/assets/app.scss ./public/assets/app.css"
    }
}
